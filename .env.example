SERIQ_DOMAIN=seriq-ai.qalau.com
# mock — тестовые ответы, model — настоящая модель
SERIQ_MODE=mock
# Максимальный размер видео, МБ
SERIQ_MAX_UPLOAD_MB=100
# Путь к файлу модели внутри контейнера
SERIQ_MODEL_PATH=/srv/models/e02_classifier.joblib
# Аккаунты и история занятий. Пусто = выключено: сервер работает без базы, как раньше
# Включение: SERIQ_DATABASE_URL=sqlite:////data/seriq.db (файл в томе seriq-data)
SERIQ_DATABASE_URL=
# Ключ подписи токенов, не короче 32 символов, только в .env на сервере (например: openssl rand -base64 48)
SERIQ_AUTH_SECRET=
